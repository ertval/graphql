{
	"name": "graphql-runtime-tests",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "npx serve .",
		"test": "npm run lint && npm run test:all",
		"test:all": "npm run test:unit && npm run test:audit && npm run test:e2e",
		"test:unit": "node --test tests/*.mjs",
		"test:audit": "node --test tests/audit/*.spec.mjs",
		"test:e2e": "playwright test",
		"test:e2e:headed": "playwright test --headed",
		"lint": "biome check .",
		"lint:fix": "biome check --write --unsafe .",
		"format": "biome format .",
		"format:fix": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.12",
		"@playwright/test": "^1.54.2"
	}
}
