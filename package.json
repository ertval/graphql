{
	"name": "graphql-runtime-tests",
	"private": true,
	"type": "module",
	"scripts": {
		"test": "node --test tests/*.mjs tests/audit/*.spec.mjs",
		"test:unit": "node --test tests/*.mjs tests/audit/*.spec.mjs",
		"test:runtime": "playwright test",
		"test:runtime:headed": "playwright test --headed",
		"lint": "biome check .",
		"lint:fix": "biome check --write --unsafe .",
		"format": "biome format .",
		"format:fix": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.12",
		"@playwright/test": "^1.54.2"
	}
}
